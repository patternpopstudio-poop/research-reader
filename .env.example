NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# This address can request a sign-in link without an invite, and is the library admin.
ADMIN_EMAIL=

# Stripe checkout (Phase 2). If STRIPE_PRICE_ID is empty, Checkout uses billing_settings as a one-time price.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=

# Purchase confirmation email (Phase 3). RESEND_FROM must be a verified Resend sender.
RESEND_API_KEY=
RESEND_FROM=
