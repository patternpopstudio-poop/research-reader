NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared admin sign-in: admin@example.com / Admin@123
# Extra admin addresses can be comma-separated.
ADMIN_EMAIL=admin@example.com

# Stripe checkout. The public plan is $7.99 USD per month.
# If STRIPE_PRICE_ID is set, it must be that monthly Price. If it is empty, Checkout creates the $7.99 subscription inline.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=

# Purchase confirmation email (Phase 3). RESEND_FROM must be a verified Resend sender.
RESEND_API_KEY=
RESEND_FROM=
